# Vagary — production environment template.
#
# Copy this to `.env.production` (git-ignored) on the server and fill in the
# blanks. Laravel loads `.env` first, then `.env.{APP_ENV}` on top of it, so
# this file only needs the values that differ from your local `.env`.
#
#   cp .env.production.example .env.production
#
# NEVER commit the real file — `.env.production` is already in .gitignore.

APP_ENV=production
APP_DEBUG=false
APP_NAME=Vagary

# Must be the exact public URL of the deployed site, no trailing slash.
APP_URL=https://your-domain.example

# ------------------------------------------------------------------
# Google OAuth ("Continue with Google")
#
# The redirect URI must be added to the SAME value under
# APIs & Credentials -> Authorised redirect URIs in Google Cloud Console,
# or Google will reject the callback:
#
#   https://your-domain.example/auth/google/callback
#
# Google only accepts `localhost` or public top-level domains here —
# reserved TLDs such as .test are refused.
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vagary
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------
# Mail — nothing is delivered until these are filled in.
#
# Gmail requires a 16-character APP PASSWORD (myaccount.google.com/
# apppasswords, with 2-Step Verification enabled) — your normal Google
# password will be rejected.
# ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# Comma separated fallback list of emails allowed to manage the catalogue.
# users.is_admin remains the primary switch.
VAGARY_ADMIN_EMAILS=